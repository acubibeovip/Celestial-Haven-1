# npm requires legacy peer resolution for this pinned stack: typescript-eslint
# 8.46.0 declares peer eslint "^8.57.0 || ^9.0.0", while the pinned ESLint is
# 10.14.0 (both versions are mandated by ADR-001 and pass the 14-day rule).
# This flag only relaxes peer-range enforcement; all direct versions stay
# exactly pinned in package.json + package-lock.json. Runtime verification
# that lint works is recorded in docs/progress.md (M0-04).
legacy-peer-deps=true
